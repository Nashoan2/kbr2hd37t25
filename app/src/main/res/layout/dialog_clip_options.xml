<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:background="@drawable/dialog_clip_options_neon"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/popup_clip_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clipboard"
        android:textColor="#00D2FF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popup_clip_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="#162842"
        android:ellipsize="end"
        android:maxLines="3"
        android:padding="10dp"
        android:textColor="#E0E6ED"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/popup_btn_pin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_editor_key"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/popup_pin_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_pin_cyan" />

        <TextView
            android:id="@+id/popup_pin_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/pin_text"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/popup_btn_delete"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_editor_key"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_trash_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/keycode_delete"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/popup_btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/ripple_all_corners_medium"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="#80A0C0"
        android:textSize="13sp" />

</LinearLayout>
